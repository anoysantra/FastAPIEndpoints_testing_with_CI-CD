pipeline {
    agent any

    options {
        timestamps()
    }

    parameters {
        string(
            name: 'API_ENDPOINT',
            defaultValue: 'https://fastapi-endpoints-new.onrender.com',
            description: 'Base URL of the already deployed FastAPI service'
        )
    }

    environment {
        TEST_IMAGE = "employee-api-tests:${BUILD_NUMBER}"
    }

    stages {

        stage('Create test credentials') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'API_TEST_CREDENTIALS_JSON',
                        variable: 'API_TEST_CREDENTIALS_JSON'
                    )
                ]) {
                    bat '''
                        if "%API_TEST_CREDENTIALS_JSON%"=="" (
                            echo Jenkins credential API_TEST_CREDENTIALS_JSON is empty
                            exit /b 1
                        )

                        echo %API_TEST_CREDENTIALS_JSON% > "%WORKSPACE%\\.ci-test-data.json"
                    '''
                }
            }
        }

        stage('Build test image') {
            steps {
                dir('api_endpoints_employee') {
                    bat 'docker build --pull -t "%TEST_IMAGE%" .'
                }
            }
        }

        stage('Run API tests') {
            steps {
                bat '''
                    if not exist "%WORKSPACE%\\reports" mkdir "%WORKSPACE%\\reports"

                    docker run --rm ^
                        --mount "type=bind,source=%WORKSPACE%\\.ci-test-data.json,target=/app/tests/data.json,readonly" ^
                        --mount "type=bind,source=%WORKSPACE%\\reports,target=/app/reports" ^
                        --env API_ENDPOINT="%API_ENDPOINT%" ^
                        "%TEST_IMAGE%" pytest -n 3 -v ^
                        --html=/app/reports/report.html ^
                        --self-contained-html
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/report.html',
                allowEmptyArchive: true,
                fingerprint: true
            )

            bat '''
                if exist "%WORKSPACE%\\.ci-test-data.json" del /f /q "%WORKSPACE%\\.ci-test-data.json"

                docker image rm "%TEST_IMAGE%" || exit /b 0
            '''
        }
    }
}
